# iOS Simulator에서 Mac 로컬 서버를 쓸 때는 기본 localhost로도 테스트할 수 있습니다.
# 실제 iPhone에서 테스트할 때는 localhost가 아니라,
# iPhone에서 접근 가능한 Spring 서버 주소를 넣어 주세요.
#
# 예시:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080/api/v1
#
# 외부 네트워크에서 쓰려면 HTTPS로 공개된 API 주소를 사용하는 것이 가장 안정적입니다.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
