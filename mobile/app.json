{
  "expo": {
    "name": "save:on",
    "slug": "saveon",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yewon.saveon20260918",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "개발 중 save:on 로컬 서버에 연결하기 위해 사용합니다.",
        "NSCalendarsUsageDescription": "저장한 콘텐츠의 일정 정보를 캘린더에 추가하기 위해 사용합니다.",
        "NSCalendarsFullAccessUsageDescription": "저장한 콘텐츠의 일정 정보를 캘린더에 추가하기 위해 사용합니다.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "저장한 콘텐츠의 일정 정보를 캘린더에 추가하기 위해 사용합니다.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.example.saveon"
    },
    "plugins": [
      "expo-font",
      "expo-calendar",
      [
        "expo-share-extension",
        {
          "activationRules": [
            {
              "type": "text"
            },
            {
              "type": "url",
              "max": 1
            }
          ],
          "height": 420,
          "backgroundColor": {
            "red": 246,
            "green": 245,
            "blue": 250,
            "alpha": 1
          }
        }
      ]
    ]
  }
}
