GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_REQUEST_TIMEOUT_MS=30000
GEMINI_RETRY_ATTEMPTS=3
GEMINI_MAX_OUTPUT_TOKENS=4096

# Search-grounded fact checking is opt-in because it adds latency and cost.
FACT_CHECK_ENABLED=false
WIKIPEDIA_REFERENCE_ENABLED=true
GEMINI_FACT_CHECK_MODEL=gemini-3.1-flash-lite
GEMINI_VERIFIED_SUMMARY_MODEL=gemini-3.1-flash-lite
MAX_FACT_CHECK_CLAIMS=3
# grounding = Gemini Google Search grounding (needs quota), search = search APIs + a
# judge that may only cite the returned snippets (see services/search_verification.py).
FACT_CHECK_ENGINE=grounding
SEARCH_PROVIDERS=wikipedia,tavily,kakao
# Optional keys. A provider without a key is skipped. Never commit real keys.
TAVILY_API_KEY=
KAKAO_REST_API_KEY=

YOUTUBE_MAX_DURATION_SECONDS=600
YOUTUBE_MAX_FILE_SIZE_MB=150
WHISPER_MODEL=base
CLIP_MODEL=openai/clip-vit-base-patch32
OCR_INTERVAL_SECONDS=0.75
OCR_MAX_FRAMES=120
# Optional override. By default, downloaded model files stay under
# saveon/.runtime/model-cache and are excluded from Git.
SAVEON_MODEL_CACHE_DIR=

# Optional internal tracing. Analysis must continue when this server is down.
DEVELOPER_TELEMETRY_ENABLED=false
DEVELOPER_API_URL=http://localhost:8100
DEVELOPER_API_TOKEN=
