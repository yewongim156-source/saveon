GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Search-grounded fact checking is opt-in because it adds latency and cost.
FACT_CHECK_ENABLED=false
GEMINI_FACT_CHECK_MODEL=gemini-3.1-flash-lite
MAX_FACT_CHECK_CLAIMS=3

YOUTUBE_MAX_DURATION_SECONDS=600
YOUTUBE_MAX_FILE_SIZE_MB=150
WHISPER_MODEL=base
CLIP_MODEL=openai/clip-vit-base-patch32
